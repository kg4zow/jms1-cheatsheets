###############################################################################

set -e

PATH="/usr/bin:/bin"

########################################
# Global variables
#   MYDIR     dir containing script   '/Users/jms1/bin'
#   MYNAME    name of script          'xyzzy'
#   MYSELF    full path to script     '/Users/jms1/bin/xyzzy'
#   REAL_XXX  if $MYSELF is a symlink, the REAL_XXX variables will have the
#             same values, for the real target of that symlink

MYDIR="$( cd -- "$( dirname -- "$0" )" >/dev/null 2>&1 || exit 1 ; pwd -P )"
MYNAME="$( basename -- "$0" )"
MYSELF="$MYDIR/$MYNAME"

REAL_MYSELF="$( readlink -f "$MYSELF" )"
REAL_MYDIR="${REAL_MYSELF%/*}"
REAL_MYNAME="${REAL_MYSELF##*/}"

########################################
# Directories used by the script itself
# XDG: https://specifications.freedesktop.org/basedir-spec/latest/

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/${MYNAME}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/${MYNAME}"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/${MYNAME}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/${MYNAME}"

CONFIG_FILE="${CONFIG_DIR}/${MYNAME}.conf"

###############################################################################
#
# Colour values
#
# A "colour value" is a sequence of digits and ';' characters which are used
# in the SGR (aka "ESC [ ... m") ANSI sequence. These are control characters
# that a computer can send to a terminal to make it print the following text
# using specific visual attributes. For example, "ESC[0;1;37;44m" tells the
# terminal:
#   - ESC   is the ESCAPE character, ASCII value 27
#   - [     means the following characters will form a command. The numbers
#           which follow are held until the command itself is received.
#   - 0     means to set the default visual state, usually normal white text
#           on a black background
#   - ;     separates the numbers from each other
#   - 1     means to make the text bold
#   - 37    means to make the text colour white (this combines with "bold")
#   - 44    means to make the text background blue
#   - m     is the command, telling the terminal that the sequence of numbers
#           should be used to set how the text *after* the sequence should be
#           shown on the display.
#
# Pre-defined colour values
#
# These are used by the XXXline() and XXXtext() functions, and by the code
# which processes the command line options.
#
# macOS uses bash 3.2.57, and earlier versions of bash (prior to 4.0) didn't
# support associative arrays. Rather than forcing Mac users to get a better
# shell (which I do recommend, even if this script doesn't *require* it), we
# "fake it" by creating individual variables with a pattern to their name
# (in this case "COLOUR_" followed by the name). The COLOUR_value() function
# below uses this pattern to get the colour value for a given name.
#
# IN MOST CASES, these values should start with '0;', to ensure that any
# attributes which may have been in effect before the sequence, are not
# inherited by text printed after the sequence. However there may be cases
# where you may *want* to inherit other attributes. Feel fre to do whatever
# makes sense for you.

COLOUR_red='0;1;37;41'
COLOUR_yellow='0;30;43'
COLOUR_blue='0;1;37;44'
COLOUR_green='0;1;37;42'
COLOUR_cyan='0;1;37;46'
COLOUR_purple='0;1;37;45'
COLOUR_white='0;1;37;47'

############################################################
# Print (return) the value for a given colour.
# - If the requested colour is already a colour value (i.e. '0;1;37;44'),
#   just return that.
# - Returns an empty string if the colour name is not known.

function COLOUR_value {
    local COL RE VAR RV

    COL="$1"

    RE='^[0-9][0-9;]*$'
    if [[ $COL =~ $RE ]]
    then
        RV="$COL"
    else
        VAR="COLOUR_$COL"
        RV="${!VAR}"
    fi

    echo "$RV"
}

###############################################################################
#
# Coloured line functions

############################################################
# Split a message into lines. Print each line in the selected colour.
# - The first parameter specifies the colour. It can either be a recognized
#   name (from a COLOUR_xxx variable), or the actual "n;n;n" value to be
#   used in the "ESC [ ___ m" sequence before the message.
# - IF the second parameter is '-d', the message(s) will be printed using
#   double-height text. The '-d' parameter will be removed.
# - If any more parmeters exist, they contain the message(s) to be printed.
#   Each parameter may be a single-line, multi-line, or empty string. Any
#   multi-line values will be split into separate lines. Any empty strings
#   (including empty lines in a multi-line string) will cause empty lines to
#   be printed.
# - If no more parameters are present, the message will be read from STDIN.
# - Resets the output to the "standard" colours afterward. This may be white
#   on black, black on white, or some other colours defined in your terminal
#   software.
# - If STDIN is empty, no output will be generated - not even the "reset to
#   standard" sequence.

function coloured_line {
    local CSPEC COL DH P IFS LINE

    ########################################
    # The first parameter (required) specifies the colour value.

    CSPEC="${1:-}"
    shift

    if [[ -z "$CSPEC" ]]
    then
        fail "ERROR: coloured_line() called with no colour"
    fi

    ########################################
    # Make sure the colour is recognized.

    COL="$( COLOUR_value "$CSPEC" )"
    if [[ -z "$COL" ]]
    then
        usage "ERROR: unknown colour '$CSPEC'"
    fi

    ########################################
    # If the next parameter is '-d', the line should be double-height.

    if [[ "$1" == '-d' ]]
    then
        DH=true
        shift
    else
        DH=false
    fi

    ############################################################
    # If any parameters remain, process them.

    if (( $# > 0 ))
    then
        for P in "$@"
        do
            ########################################
            # If the parameter is non-empty, split its value into lines and
            # print each line with the appropriate escape codes.

            if [[ -n "$P" ]]
            then
                while IFS='' read -r LINE
                do
                    if $DH
                    then
                        printf "\e#3\e[%sm%s\e[0K\e[0m\n" "$COL" "$LINE"
                        printf "\e#4\e[%sm%s\e[0K\e[0m\n" "$COL" "$LINE"
                    else
                        printf "\e[%sm%s\e[0K\e[0m\n" "$COL" "$LINE"
                    fi
                done <<< "$P"

            ########################################
            # The parameter is empty, print an empty line (in the selected
            # colour).

            else
                if $DH
                then
                    printf "\e#3\e[%sm%s\e[0K\e[0m\n" "$COL" "$LINE"
                    printf "\e#4\e[%sm%s\e[0K\e[0m\n" "$COL" "$LINE"
                else
                    printf "\e[%sm%s\e[0K\e[0m\n" "$COL" ''
                fi
            fi
        done

    ############################################################
    # Otherwise (if no more parameters exist), process lines from STDIN.
    # - Each line will be printed, with the appropriate colour codes.
    # - Empty lines are printed as empty strings, in the appropriate colour.
    # - If STDIN is empty, nothing will be printed.

    else
        while IFS='' read -r LINE
        do
            if $DH
            then
                printf "\e#3\e[%sm%s\e[0K\e[0m\n" "$COL" "$LINE"
                printf "\e#4\e[%sm%s\e[0K\e[0m\n" "$COL" "$LINE"
            else
                printf "\e[%sm%s\e[0K\e[0m\n" "$COL" "$LINE"
            fi
        done
    fi
}

############################################################
# Wrappers which specify different colours

function redline {
    coloured_line "$COLOUR_red" "$@"
}

function yellowline {
    coloured_line "$COLOUR_yellow" "$@"
}

function blueline {
    coloured_line "$COLOUR_blue" "$@"
}

function greenline {
    coloured_line "$COLOUR_green" "$@"
}

function cyanline {
    coloured_line "$COLOUR_cyan" "$@"
}

function purpleline {
    coloured_line "$COLOUR_purple" "$@"
}

function whiteline {
    coloured_line "$COLOUR_white" "$@"
}

############################################################
# Convenience function - print an error message and exit the script. This
# is similar to Perl's die() function.

function fail {
    redline "$@"
    exit 1
}

###############################################################################
#
# Coloured TEXT functions. Just print the string in colour AS-IS, without
# worrying about complete lines. (Think '<span>' instead of '<div>'.)
#
# Note that these functions do not support the '-d' for double-height text,
# since the double-height flags are attached to an entire line rather than
# specific characters.

function coloured_text {
    local CSPEC COL MSG ITEM

    ########################################
    # The first parameter (required) specifies the colour value.

    CSPEC="${1:?no colour code specified}"
    shift

    COL="$( COLOUR_value "$CSPEC" )"
    if [[ -z "$COL" ]]
    then
        usage "ERROR: unknown colour '$CSPEC'"
    fi

    ########################################
    # If any parameters remain (after shifting off the colour code), join
    # them as a single string and print that in colour. Joining the strings
    # is done using "$*", which means the input items will be separated by
    # the first character of $IFS in the resulting "joined" string.

    if (( $# > 0 ))
    then
        MSG="$*"
        printf "\e[%sm%s\e[0m" "$COL" "$MSG"

    ########################################
    # Otherwise (if no more parameters exist), process STDIN.
    # - All input will be joined into a single string, with newlines between
    #   the input lines, but with no newline at the end.
    # - That string will be printed, in the chosen colour.

    else
        MSG=''

        while IFS='' read -r ITEM
        do
            if [[ -n "$MSG" ]]
            then
                MSG="$MSG"$'\n'
            fi

            MSG="$MSG$ITEM"
        done

        printf '\e[%sm%s\e[0m' "$COL" "$MSG"
    fi
}

############################################################
# Wrappers which specify different colours

function redtext {
    coloured_text "$COLOUR_red" "$@"
}

function yellowtext {
    coloured_text "$COLOUR_yellow" "$@"
}

function bluetext {
    coloured_text "$COLOUR_blue" "$@"
}

function greentext {
    coloured_text "$COLOUR_green" "$@"
}

function cyantext {
    coloured_text "$COLOUR_cyan" "$@"
}

function purpletext {
    coloured_text "$COLOUR_purple" "$@"
}

function whitetext {
    coloured_text "$COLOUR_white" "$@"
}

###############################################################################
#
# Maybe print a command before executing it

SET_X="${SET_X:-false}"

function set_x {
    local IFS=' '
    if [[ "${SET_X:-false}" == "true" ]]
    then
        cyanline "$PS4$*" 1>&2
    fi
    "$@"
}

########################################
# Show the same output that set_x would show,
# but don't actually run the command

function show_x {
    local IFS=' '
    if [[ "${SET_X:-false}" == "true" ]]
    then
        cyanline "$PS4$*" 1>&2
    fi
}

###############################################################################
#
# Debugging message

DO_DEBUG="${DO_DEBUG:-false}"
DEBUG_PREFIX=$'\f'

function debug {
    local IFS LINE LINES PREFIX

    if [[ "${DO_DEBUG:-false}" == "true" ]]
    then
        if [[ "$DEBUG_PREFIX" == $'\f' ]]
        then
            local CALLER C_LINE C_FILE
            CALLER="$( caller )"
            C_LINE="${CALLER% *}"
            C_FILE="${CALLER#* }"
            PREFIX="$C_FILE:$C_LINE: "
        else
            PREFIX="$DEBUG_PREFIX"
        fi

        IFS=$'\n' read -a LINES -d '' -r <<< "$*" || true
        for LINE in "${LINES[@]}"
        do
            yellowline "$PREFIX$LINE" 1>&2
        done
    fi
}

###############################################################################
#
# Usage
# - https://docopt.org/ is the "standard" for how to describe options

function usage {
    local MSG
    MSG="${*:-}"

    cat <<EOF
$0 [OPTIONS] [ARGS]

Detailed description of what the script does.

-b      Enable BVAR

-s ___  Specify SVAR

-x      Show the important commands before executing them.

-D      Show debugging messages. Also enables '-x'.

-h      Show this help message.

Note: part of the example code below illustrates how to handle cases where
a certain number of parameters are required, but show the usage message if
no parameters are supplied. This means in order to see the final message
you will need to specify at least two arguments.

Last updated $LAST_UPDATED

EOF

    if [[ -n "$MSG" ]]
    then
        fail "$MSG"
    fi

    exit 0
}

###############################################################################
###############################################################################
###############################################################################
#
# Process the command line

BVAR=false
SVAR="(default)"

while getopts ':hbs:xD' OPT
do
    case $OPT in
        h)  usage
            ;;
        b)  BVAR=true
            ;;
        s)  SVAR="$OPTARG"
            ;;
        x)  SET_X=true
            ;;
        D)  DO_DEBUG=true
            SET_X=true
            ;;
        *)  usage "ERROR: unknown option '-${OPTARG}'"
            ;;
    esac
done

shift $(( OPTIND - 1 ))

ARG1="${1:-}"
ARG2="${2:-}"

if [[ -z "$ARG1" ]]
then
    usage
fi

if [[ -z "$ARG2" ]]
then
    usage "ERROR: missing ARG2"
fi

###############################################################################
#
# Do the things

cat <<EOF
MYDIR       '${MYDIR}'
MYNAME      '${MYNAME}'
MYSELF      '${MYSELF}'
REAL_MYSELF '${REAL_MYSELF}'
REAL_MYDIR  '${REAL_MYDIR}'
REAL_MYNAME '${REAL_MYNAME}'

CACHE_DIR   '${CACHE_DIR}'
CONFIG_DIR  '${CONFIG_DIR}'
DATA_DIR    '${DATA_DIR}'
STATE_DIR   '${STATE_DIR}'
CONFIG_FILE '${CONFIG_FILE}'

SET_X       '${SET_X}'
DO_DEBUG    '${DO_DEBUG}'

BVAR        '${BVAR}'
SVAR        '${SVAR}'
ARG1        '${ARG1}'
ARG2        '${ARG2}'

\$*         '$*'
\$@         '$@'
EOF
