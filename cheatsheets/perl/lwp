############################################################
# Generic web client - create/use an LWP::UserAgent object
# - functions that make web requests will call setup_ua() first

use LWP ;

my $ua       = undef ;
my $ua_agent = 'test/0.1 ' ;
my $ca_file  = '' ;
my @ca_files =
(
    '/etc/pki/tls/cert.pem' ,
    '/usr/local/etc/ca-certificates/cert.pem' ,
) ;

sub find_ca_file()
{
    $ca_file = '' ;

    for my $f ( @ca_files )
    {
        if ( ( -f $f ) && ( -r $f ) )
        {
            $ca_file = $f ;
            last ;
        }
    }

    if ( $ca_file eq '' )
    {
        die "ERROR: unable to find a usable CA cert file\n" ;
    }

    return $ca_file ;
}

sub setup_ua()
{
    unless ( defined( $ua ) )
    {
        $ua = new LWP::UserAgent() ;
        $ua->agent( $ua_agent ) ;

        ########################################
        # needed for SSL requests

        $ua->ssl_opts(
            verify_hostname => $ssl_verify ,
            SSL_ca_file     => find_ca_file() ,
        ) ;
    }
}

############################################################
# Send simple GET request

setup_ua() ;
$req = new HTTP::Request( 'GET' => $url ) ;
if ( defined $token )
{
    $req->header( 'Authorization' , "Session $token" ) ;
}

$res = $ua->request( $req ) ;

print $res->content() ;

